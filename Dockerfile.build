FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        default-libmysqlclient-dev \
        libcrypt-dev \
        libxml2-dev \
        zlib1g-dev \
        make \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /durismud

COPY . .

RUN cp src/Makefile.linux src/Makefile \
    && cp src/ships/Makefile.linux src/ships/Makefile

WORKDIR /durismud/src

CMD ["make", "dms_new"]
